LLM_PROVIDER=groq
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Nimbus guardrail (prose docs)
GUARDRAIL_SIMILARITY_THRESHOLD=0.3

# Resume agent
RESUME_GUARDRAIL_SIMILARITY_THRESHOLD=0.15
SESSION_TTL_SECONDS=1800
SESSION_SWEEP_INTERVAL_SECONDS=300
RESUME_MAX_PAGES=20
RESUME_PDF_EXTRACTION_MODE=plain
