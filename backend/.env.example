LLM_PROVIDER=groq
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Guardrail — pick a strategy, see backend/app/config/guardrails.py for the tradeoffs of each.
# Options: retrieval_threshold (default, most reliable) | nli_entailment | hhem
GUARDRAIL_STRATEGY=retrieval_threshold

# retrieval_threshold — per-domain (Nimbus prose vs. resume fragments score differently)
GUARDRAIL_SIMILARITY_THRESHOLD_NIMBUS=0.3
GUARDRAIL_SIMILARITY_THRESHOLD_RESUME=0.15

# nli_entailment
GUARDRAIL_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
GUARDRAIL_ENTAILMENT_THRESHOLD=0.3

# hhem
GUARDRAIL_HHEM_MODEL=vectara/hallucination_evaluation_model
GUARDRAIL_HHEM_THRESHOLD=0.5

# Resume agent
SESSION_TTL_SECONDS=1800
SESSION_SWEEP_INTERVAL_SECONDS=300
RESUME_MAX_PAGES=20
RESUME_PDF_EXTRACTION_MODE=plain
